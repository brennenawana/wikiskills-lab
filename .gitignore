# Everything generated for one user stays on their machine.
workspace/*
!workspace/README.md

# Benchmark data is downloaded from its original sources, never stored here.
benchmarks/spreadsheet/data/
# Local reproduction runs (ledgers, traces, workdirs) stay on your machine.
benchmarks/spreadsheet/runs_local/
benchmarks/spreadsheet/adapter/caps.json

# The usual noise
__pycache__/
*.pyc
.DS_Store
